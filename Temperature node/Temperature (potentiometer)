#include <Wire.h>

#include "NodeLogic.h"

const uint8_t I2C_ADDRESS = 0x08;

const uint8_t POTENTIOMETER_PIN = A0;
const uint8_t GREEN_LED_PIN = 8;
const uint8_t RED_LED_PIN = 9;

const unsigned long SENSOR_INTERVAL_MS = 100;
const unsigned long STATUS_INTERVAL_MS = 500;
const unsigned long COMMAND_TIMEOUT_MS = 2500;

volatile uint16_t sharedTemperatureCentiC = 0;
volatile uint8_t pendingCommand = NODE_COMMAND_SLEEP;
volatile bool commandAvailable = false;

uint8_t activeCommand = NODE_COMMAND_SLEEP;
unsigned long lastCommandTime = 0;
unsigned long lastSensorTime = 0;
unsigned long lastStatusTime = 0;

int readAveragePotentiometer() {
  long total = 0;
  const uint8_t sampleCount = 10;

  for (uint8_t sample = 0; sample < sampleCount; ++sample) {
    total += analogRead(POTENTIOMETER_PIN);
    delay(5);
  }

  return total / sampleCount;
}

uint16_t convertPotentiometerToCentiC(int rawValue) {
  // Convert ADC range 0-1023 to 0.00-40.00 degrees Celsius.
  return static_cast<uint16_t>(
      (static_cast<unsigned long>(rawValue) * 4000UL + 511UL) / 1023UL);
}

void sendTemperatureToController() {
  const uint16_t snapshot = sharedTemperatureCentiC;

  Wire.write(static_cast<uint8_t>(snapshot >> 8));
  Wire.write(static_cast<uint8_t>(snapshot & 0xFF));
}

void receiveControllerCommand(int byteCount) {
  if (byteCount > 0 && Wire.available()) {
    const uint8_t command = Wire.read();

    if (command <= NODE_COMMAND_COOLING) {
      pendingCommand = command;
      commandAvailable = true;
    }
  }

  while (Wire.available()) {
    Wire.read();
  }
}

void applyOutputs(const NodeState& state) {
  digitalWrite(RED_LED_PIN, state.redLed ? HIGH : LOW);
  digitalWrite(GREEN_LED_PIN, state.greenLed ? HIGH : LOW);
}

const char* commandName(uint8_t command) {
  switch (command) {
    case NODE_COMMAND_COMFORTABLE:
      return "OCCUPIED / COMFORTABLE";
    case NODE_COMMAND_HEATING:
      return "HEATING";
    case NODE_COMMAND_COOLING:
      return "COOLING";
    default:
      return "SLEEP / UNOCCUPIED";
  }
}

void setup() {
  Serial.begin(9600);

  pinMode(GREEN_LED_PIN, OUTPUT);
  pinMode(RED_LED_PIN, OUTPUT);
  applyOutputs(nodeStateForCommand(NODE_COMMAND_SLEEP, false));

  Wire.begin(I2C_ADDRESS);
  Wire.onRequest(sendTemperatureToController);
  Wire.onReceive(receiveControllerCommand);

  lastCommandTime = millis();

  Serial.println("Arduino 1 ready at I2C address 0x08");
  Serial.println("Initial state: SLEEP / UNOCCUPIED");
}

void loop() {
  bool receivedNewCommand = false;
  uint8_t receivedCommand = NODE_COMMAND_SLEEP;

  noInterrupts();
  if (commandAvailable) {
    receivedCommand = pendingCommand;
    commandAvailable = false;
    receivedNewCommand = true;
  }
  interrupts();

  if (receivedNewCommand) {
    activeCommand = receivedCommand;
    lastCommandTime = millis();
  }

  const unsigned long now = millis();
  const bool communicationTimedOut =
      now - lastCommandTime > COMMAND_TIMEOUT_MS;
  const NodeState state =
      nodeStateForCommand(activeCommand, communicationTimedOut);

  applyOutputs(state);

  // In software sleep, analogRead is not performed.
  if (state.active && now - lastSensorTime >= SENSOR_INTERVAL_MS) {
    lastSensorTime = now;

    const int rawValue = readAveragePotentiometer();
    const uint16_t temperatureCentiC =
        convertPotentiometerToCentiC(rawValue);

    noInterrupts();
    sharedTemperatureCentiC = temperatureCentiC;
    interrupts();
  }

  if (now - lastStatusTime >= STATUS_INTERVAL_MS) {
    lastStatusTime = now;

    Serial.print("State: ");
    if (communicationTimedOut) {
      Serial.print("SLEEP / I2C TIMEOUT");
    } else {
      Serial.print(commandName(activeCommand));
    }

    if (state.active) {
      uint16_t temperatureSnapshot;

      noInterrupts();
      temperatureSnapshot = sharedTemperatureCentiC;
      interrupts();

      Serial.print(" | Temperature: ");
      Serial.print(temperatureSnapshot / 100.0, 1);
      Serial.print(" C");
    } else {
      Serial.print(" | Temperature sensing stopped");
    }

    Serial.println();
  }
}
