#include <Wire.h>

#include "PirLogic.h"

const uint8_t I2C_ADDRESS = 0x09;
const uint8_t PIR_PIN = 2;

volatile uint8_t sharedPirStatus = 0;
bool previousMotionState = false;

void sendPirStatusToController() {
  Wire.write(sharedPirStatus);
}

void setup() {
  Serial.begin(9600);
  pinMode(PIR_PIN, INPUT);

  // Arduino 3 is an I2C peripheral, not the controller.
  Wire.begin(I2C_ADDRESS);
  Wire.onRequest(sendPirStatusToController);

  Serial.println("Arduino 3 PIR node ready at I2C address 0x09");
  Serial.println("PIR output connected to D2");
  Serial.println("Allow the PIR sensor time to stabilise after power-up.");
}

void loop() {
  const bool motionDetected = digitalRead(PIR_PIN) == HIGH;
  const uint8_t encodedStatus = encodePirSignal(motionDetected);

  noInterrupts();
  sharedPirStatus = encodedStatus;
  interrupts();

  if (motionDetected != previousMotionState) {
    previousMotionState = motionDetected;
    Serial.print("PIR status: ");
    Serial.println(motionDetected ? "MOTION" : "NO MOTION");
  }

  delay(20);
}
